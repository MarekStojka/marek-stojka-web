---
import { withBase } from '../../../lib/site-path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MagazineHeader from '../../../components/MagazineHeader.astro';
import BrushIcon from '../../../components/BrushIcon.astro';
import { creativeWorkshops } from '../../../data/creative-workshops';
import { publicContact } from '../../../data/contact';
import '../../../styles/creative-editorial.css';
export function getStaticPaths(){return creativeWorkshops.map(workshop=>({params:{slug:workshop.slug},props:{workshop}}));}
const {workshop}=Astro.props;
const interestLink=`mailto:${publicContact.email}?subject=${encodeURIComponent(`Zájem o workshop: ${workshop.title}`)}`;
---
<BaseLayout title={`${workshop.title} — připravovaný workshop Marka Stojky`} description={workshop.intro} noindex={true}>
<div class="editorial-page workshop-detail" style={{'--workshop-color':workshop.color}}><MagazineHeader/><main id="obsah">
 <header class="workshop-hero"><a href={withBase('/kreativec#workshopy')}>← Všechny workshopy</a><div><BrushIcon kind={workshop.icon}/><h1>{workshop.title}</h1><p>{workshop.intro}</p></div><p class="workshop-state">Připravovaný živý workshop. Termín, místo a cena budou doplněné.</p></header>
 <section class="workshop-purpose"><div><h2>Pro koho to je.</h2><p>{workshop.forWhom}</p></div><div><h2>Co si vyzkoušíte.</h2><p>{workshop.goal}</p></div></section>
 <section class="workshop-facts" aria-label="Plánovaná podoba workshopu"><p><strong>3 hodiny</strong> včetně přestávky</p><p><strong>6–12 dospělých</strong> plánovaná velikost skupiny</p><p><strong>Samostatně i v cyklu</strong> předchozí účast není nutná</p></section>
 <section class="workshop-agenda"><h2>Jak by setkání probíhalo.</h2><p>{workshop.detailed?'Pracovní program vychází z připraveného návrhu prvního workshopu.':'Pracovní návrh programu rozvíjí téma ve stejné struktuře jako první workshop. Detaily budeme ještě ladit.'}</p><div>{workshop.agenda.map(item=><details><summary><h3>{item.title}</h3><span>{item.minutes} min <span aria-hidden="true">+</span></span></summary><p>{item.text}</p></details>)}</div></section>
 <section class="workshop-exercise"><BrushIcon kind="draw"/><div><h2>{workshop.exercise}</h2><p>{workshop.exerciseCopy}</p></div></section>
 <section class="workshop-takeaway"><h2>Co si můžete<br /><em>odnést s sebou.</em></h2><div>{workshop.takeaway.map(item=><p>{item}</p>)}</div></section>
 <section class="workshop-interest"><div><h2>Tohle téma<br /><em>vás zajímá?</em></h2><p>Napište mi, co byste si chtěli vyzkoušet. Zatím jde o vyjádření zájmu, ne o rezervaci místa.</p></div><a href={interestLink}>Napsat o tomto workshopu <span aria-hidden="true">↗</span></a></section>
 <nav class="editorial-other-rubrics" aria-label="Další workshopy"><h2>Další témata naživo.</h2>{creativeWorkshops.filter(item=>item.slug!==workshop.slug).map(item=><a href={withBase(`/kreativec/workshopy/${item.slug}`)}>{item.title} ↗</a>)}</nav>
 </main></div>
</BaseLayout>
<style>
.workshop-hero{background:var(--workshop-color)!important;padding:35px 6% 45px}.workshop-hero>div{max-width:1100px;margin:45px auto;text-align:center}.workshop-hero :global(svg){width:125px;height:125px;margin:0 auto 30px}.workshop-hero h1{font-size:clamp(48px,6vw,90px)}.workshop-hero>div>p{font-size:26px;max-width:700px;margin:30px auto 0}.workshop-hero .workshop-state{font-size:17px;text-align:center}.workshop-purpose{display:grid;grid-template-columns:1fr 1fr;padding:55px 6%;gap:10%}.workshop-purpose h2{font-size:37px}.workshop-facts{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;padding:30px 6%}.workshop-facts strong{font-weight:500;font-size:29px;color:#222;display:block;letter-spacing:-.05em;margin-bottom:10px}.workshop-facts p{font-size:16px;margin:0}.workshop-agenda{padding:55px 6%}.workshop-agenda>h2{font-size:45px}.workshop-agenda>p{max-width:850px}.workshop-agenda>div{margin-top:35px}.workshop-agenda details{border-top:1px solid #ccc}.workshop-agenda details:last-child{border-bottom:1px solid #ccc}.workshop-agenda summary{display:flex;justify-content:space-between;align-items:center;gap:25px;cursor:pointer;padding:23px 0;list-style:none}.workshop-agenda summary::-webkit-details-marker{display:none}.workshop-agenda h3{font-size:27px}.workshop-agenda summary>span{font-size:17px;white-space:nowrap;color:#666}.workshop-agenda summary>span>span{display:inline-block;margin-left:20px;font-size:23px}.workshop-agenda details[open] summary>span>span{transform:rotate(45deg)}.workshop-agenda details p{max-width:850px;margin:0 0 25px}.workshop-exercise{display:grid;grid-template-columns:120px 1fr;gap:50px;padding:50px 6%;background:var(--workshop-color)!important}.workshop-exercise :global(svg){width:120px;height:120px}.workshop-exercise h2{font-size:43px}.workshop-exercise p{font-size:22px;max-width:900px}.workshop-takeaway{padding:55px 6%;display:grid;grid-template-columns:1fr 1fr;gap:10%}.workshop-takeaway h2,.workshop-interest h2{font-size:50px}.workshop-takeaway p{border-top:1px solid #ccc;padding:20px 0;margin:0;font-size:21px}.workshop-interest{padding:50px 6%;display:flex;justify-content:space-between;align-items:center;gap:50px}.workshop-interest p{max-width:550px}.workshop-interest>a{display:flex;gap:35px;border-bottom:1px solid #aaa;padding:15px 0;font-size:21px;flex-shrink:0}
@media(max-width:700px){.workshop-hero{padding:25px 7% 30px}.workshop-hero>div{margin:35px auto}.workshop-hero h1{font-size:46px}.workshop-hero :global(svg){width:95px;height:95px}.workshop-hero>div>p{font-size:22px}.workshop-purpose,.workshop-facts,.workshop-takeaway{grid-template-columns:1fr;gap:25px;padding:35px 7%}.workshop-agenda{padding:35px 7%}.workshop-agenda>h2{font-size:37px}.workshop-agenda h3{font-size:24px}.workshop-agenda summary{gap:15px}.workshop-agenda summary>span{font-size:15px}.workshop-agenda summary>span>span{margin-left:8px}.workshop-exercise{grid-template-columns:1fr;gap:20px;padding:35px 7%}.workshop-exercise :global(svg){width:85px;height:85px}.workshop-exercise h2{font-size:35px}.workshop-exercise p{font-size:20px}.workshop-takeaway h2,.workshop-interest h2{font-size:42px}.workshop-interest{display:block;padding:35px 7%}.workshop-interest>a{font-size:19px;width:fit-content}}
</style>
