---
import { withBase } from '../../../lib/site-path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MagazineHeader from '../../../components/MagazineHeader.astro';
import ExerciseDirectory from '../../../components/ExerciseDirectory.astro';
import CreativityOverview from '../../../components/CreativityReader.astro';
import CreativitySources from '../../../components/CreativitySources.astro';
import CreativityDefinitions from '../../../components/CreativityDefinitions.astro';
import CreativityContext from '../../../components/CreativityContext.astro';
import { creativeExercises } from '../../../data/creative-exercises';
import MagazineArticleTile from '../../../components/MagazineArticleTile.astro';
import { creativeCategories } from '../../../data/creative-categories';
import { creativeArticles } from '../../../data/creative-articles';
import { publicContact } from '../../../data/contact';
import '../../../styles/creative-editorial.css';
import '../../../styles/creativity-introduction.css';
export function getStaticPaths(){return creativeCategories.map(category=>({params:{rubrika:category.id},props:{category}}));}
const {category}=Astro.props;
const articles=creativeArticles.filter(article=>article.category===category.id);
const [featured,...remaining]=articles;
---
<BaseLayout title={`${category.title} — Magazín o kreativitě`} description={category.intro} noindex={category.id!=='cviceni' && !articles.some(article=>article.status==='published')}>
<div class:list={["editorial-page editorial-category-page", {"exercise-catalog-page": category.id==='cviceni', "creativity-overview-page": category.id==='obecne'}]} style={{'--rubric-accent':category.accent,'--rubric-color':category.color}}><MagazineHeader/><main id="obsah">
 {category.id==='obecne' ? <CreativityOverview /> : <>
 <header class="editorial-rubric-heading"><a class="editorial-back-link" href={withBase('/kreativec#zapisnik')}><span aria-hidden="true">←</span> Zpět na přehled magazínu</a><h1>{category.title}</h1><p>{category.id==='cviceni' ? `${creativeExercises.length} způsobů, jak rozhýbat nápady. Psaním, kreslením, jiným pohledem i společnou tvorbou.` : category.intro}</p></header>
 {category.id==='odborne' ? <><CreativityDefinitions /><CreativityContext />{articles.length>0 && <section class="rubric-article-tiles" aria-labelledby="research-reading-title"><h2 id="research-reading-title">Další odborné čtení.</h2><div class="rubric-article-grid">{articles.map(article=><MagazineArticleTile article={article}/>)}</div></section>}</> : category.id==='cviceni' ? <><ExerciseDirectory />{articles.length>0 && <section class="rubric-article-tiles" aria-labelledby="exercise-reading-title"><h2 id="exercise-reading-title">Čtení ke cvičením.</h2><div class="rubric-article-grid">{articles.map(article=><MagazineArticleTile article={article}/>)}</div></section>}</> : featured ? <><section class="rubric-featured-tile" aria-label="Hlavní příspěvek"><MagazineArticleTile article={featured} featured/></section>
 <section class="rubric-article-tiles" aria-labelledby="posts-title"><h2 id="posts-title">Další čtení z rubriky.</h2>{remaining.length?<div class="rubric-article-grid">{remaining.map(article=><MagazineArticleTile article={article}/>)}</div>:<p>Další články teprve připravuji.</p>}</section></> : <section class="editorial-empty"><h2>{category.id==='spoluprace'?'Co můžeme otevřít společně?':'První příspěvek teprve vznikne.'}</h2><p>{category.pending}</p>{category.id==='spoluprace'&&<a href={`mailto:${publicContact.email}`}>Napište mi ↗</a>}<p class="editorial-draft">Tady bude hlavní aktuální příspěvek a pod ním přehled dalších článků.</p></section>}

 </>}
 <nav class="editorial-other-rubrics" aria-label="Další rubriky"><h2>Kam dál?</h2>{creativeCategories.filter(item=>item.id!==category.id).map(item=><a href={withBase(`/kreativec/magazin/${item.id}`)}>{item.title} ↗</a>)}</nav>
 {category.id==='obecne' && <CreativitySources />}
</main></div>
</BaseLayout>
