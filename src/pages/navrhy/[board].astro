---
import meetPreview from '../../../docs/nahled-potkejme-se.jpg';
import creativePreview from '../../../docs/nahled-kreativec.jpg';
import humorPreview from '../../../docs/nahled-humor.jpg';
import moonikaPreview from '../../../docs/nahled-moonika.jpg';
import homePreview from '../../../docs/nahled-rozcestnik.jpg';
import darkPreview from '../../../docs/nahled-temna-strana.jpg';
import authorPreview from '../../../docs/nahled-autor.jpg';
import servicesPreview from '../../../docs/nahled-ikony-hover.jpg';
import adminPreview from '../../../docs/nahled-administrace.jpg';
import footerPreview from '../../../docs/nahled-paticka.jpg';
import aiStudy from '../../assets/artwork/ai-surrealni-kreativec-v1.png';

// This review surface exists only in local development, never in the public build.
export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { board: 'prehled' } }] : [];
}
---
<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>kreativno — pracovní plátna</title>
  <style>
    *{box-sizing:border-box}body{margin:0;background:#ededea;color:#242622;font:14px/1.55 system-ui,sans-serif}a{color:inherit;text-underline-offset:4px}button,input{font:inherit}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible{outline:2px solid #526841;outline-offset:4px}header{padding:30px 40px;background:#fafaf7;border-bottom:1px solid #d6d8d0;display:flex;justify-content:space-between;align-items:center;gap:25px}h1{font-size:25px;font-weight:500;letter-spacing:-.04em;margin:4px 0}header p{margin:0;color:#6c7166;font-size:12px}.eyebrow{letter-spacing:.14em;font-size:10px;color:#6c7166}nav{display:flex;gap:20px;font-size:12px}.toolbar{padding:18px 40px;display:flex;align-items:center;justify-content:space-between;gap:25px;background:#fafaf7;border-bottom:1px solid #d6d8d0}.zoom-control{display:flex;gap:15px;align-items:center;white-space:nowrap;font-size:12px}input[type=range]{width:110px;accent-color:#56654e}.toolbar p{font-size:12px;color:#6c7166;margin:0}.canvas{overflow:auto;padding:40px;min-height:calc(100svh - 195px)}.frames{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30px;width:calc(1120px * var(--zoom,1));align-items:start}.frame-head{display:flex;justify-content:space-between;align-items:start;gap:20px;margin-bottom:15px}h2{font-size:17px;font-weight:500;margin:0 0 4px;letter-spacing:-.025em}.path{font-size:12px;color:#6c7166}.status{font-size:11px;white-space:nowrap;border-radius:20px;background:#dce2d6;color:#3d5033;padding:5px 9px}.status.draft{background:#e2e2dc;color:#606353}.screen{display:block;box-shadow:0 8px 25px #252b2012;background:#0d0e0e}img{width:100%;height:auto;display:block}.frame-foot{background:#fafaf7;padding:17px 19px}.frame-foot p{margin:0;color:#6c7166;font-size:12px}.frame-foot a{display:inline-block;margin-top:12px;font-size:12px}.map{margin-top:30px;font-size:12px;color:#6c7166}.map strong{font-weight:500;color:#242622}.hint{max-width:1120px;font-size:12px;color:#6c7166;margin-top:30px}@media(max-width:650px){header{padding:22px;align-items:start;flex-direction:column}.toolbar{padding:16px 22px;flex-wrap:wrap;gap:12px}.canvas{padding:25px 22px}.toolbar p{max-width:260px}.zoom-control{margin-left:auto}nav{gap:17px}}
  </style>
</head>
<body>
  <header><div><span class="eyebrow">kreativno / PRACOVNÍ PŘEHLED</span><h1>Nejdřív směr. Potom detaily.</h1><p>Úvod, autor a hororové příběhy na jednom místě. Obsah zůstává pracovní.</p></div><nav aria-label="Živé náhledy"><a href="/" target="_blank" rel="noreferrer">Otevřít web ↗</a><a href="/temnota" target="_blank" rel="noreferrer">Otevřít příběhy ↗</a></nav></header>
  <div class="toolbar"><p>Homepage: harmonika → proměnlivý slogan → skládaný portrét → nabídka → kontakt</p><label class="zoom-control">Velikost pláten <input type="range" min="40" max="150" value="100" step="5" aria-label="Velikost pláten" /><output>100 %</output></label></div>
  <main class="canvas"><div class="frames"><section aria-labelledby="admin-board"><div class="frame-head"><h2 id="admin-board">Správa článků / Keystatic</h2><span class="status draft">Pouze lokálně</span></div><a class="screen" href="/administrace"><img src={adminPreview.src} width={adminPreview.width} height={adminPreview.height} alt="Přehled článků, tvorba konceptu a vstup do editoru."/></a><div class="frame-foot"><p>Rubriky, fotografie a přeskupitelné textové bloky. Uložení, náhled a stav publikace; online nasazení zatím není připojené.</p><a href="/administrace">Otevřít správu obsahu ↗</a></div></section><section aria-labelledby="creative-board"><div class="frame-head"><h2 id="creative-board">Kreativita / Magazín</h2><span class="status draft">Pracovní návrh</span></div><a class="screen" href="/kreativec"><img src={creativePreview.src} width={creativePreview.width} height={creativePreview.height} alt="Osm stejně velkých bílých dlaždic rubrik se zvětšenými fotografiemi." /></a><div class="frame-foot"><p>Osm bílých fotografických rubrik, levandulový úvod s animovanými ikonami, růžové workshopy, větší fotografie a bílý medailonek. Rubriky mají fotografické článkové dlaždice; detail nabízí postranní navigaci a různé bloky sazby. Kruh zůstává v kreativních cvičeních.</p><a href="/kreativec">Otevřít magazín ↗</a></div></section>
<section aria-labelledby="humor-board"><div class="frame-head"><h2 id="humor-board">Humor / Bez dozoru</h2><span class="status draft">Pracovní návrh</span></div><a class="screen" href="/humor"><img src={humorPreview.src} width={humorPreview.width} height={humorPreview.height} alt="Barevná humorová knihovna s pastelkovými tahy a čtyřmi knihami." /></a><div class="frame-foot"><p>Celoplošné prokliky s fialovým přelivem; uvnitř decentní samovolné stékání barvy přes dlaždice. Žádné malování myší. Harmonika a papírky zachované. Kliknutí na papírek odhalí druhou část hlášky. Obsah knih zůstává pracovní.</p><a href="/humor">Otevřít humor ↗</a></div></section>
<section aria-labelledby="meet-board">
<div class="frame-head"><h2 id="meet-board">Potkejme se / Setkání a kontakt</h2><span class="status draft">Pracovní návrh</span></div>
<a class="screen" href="/potkejme-se"><img src={meetPreview.src} width={meetPreview.width} height={meetPreview.height} alt="Potkejme se s kupičkou kávových zrnek." /></a>
<div class="frame-foot"><p>Nejbližší akce s připraveným odpočtem, workshopy, konzultace, knihy a kontakt. První termín není vypsaný.</p><a href="/potkejme-se">Otevřít setkání ↗</a></div></section>
    <section aria-labelledby="moonika-board"><div class="frame-head"><div><h2 id="moonika-board">Moonika / Prezentace pod harmonikou</h2></div><span class="status draft">Pracovní vizuály</span></div><a class="screen" href="/temnota#moonika"><img src={moonikaPreview.src} width={moonikaPreview.width} height={moonikaPreview.height} alt="Moonika: kniha v popelu přímo pod knižní harmonikou." /></a><div class="frame-foot"><p>Kliknutí na knihu přepne obsah pod harmonikou ve stejné stránce. Moonika má fotografie, prostor pro anotaci a ukázku, osobní text a vydání 2027. Ostatní knihy mají zatím potvrzený stav.</p><a href="/temnota#moonika">Otevřít Mooniku ↗</a></div></section>
    <section aria-labelledby="services-board"><div class="frame-head"><div><h2 id="services-board">S čím pomůžu / Štětcové ikony</h2><span class="path">Pod portrétem / nabídka, představení, kontakt</span></div><span class="status draft">Pracovní návrh</span></div><a class="screen" href="/#co-delam" target="_blank" rel="noreferrer" aria-label="Otevřít novou nabídku pomoci"><img src={servicesPreview.src} width={servicesPreview.width} height={servicesPreview.height} alt="Třicet stejně vysokých bílých dlaždic, pouze černé ikony uprostřed, nadpis Tohle všechno dělám." /></a><div class="frame-foot"><p>Vycentrovaný nadpis. Třicet vlastních ikon pro autorovy oblasti tvorby a zkušenosti. Hover a focus zvýrazní kartu a rozehrají krátkou tematickou animaci. Kliknutí odhalí černou kartu s vysvětlením. Po navštívení všech 30 se přepne celá homepage do tmy. Pět sloupců na desktopu, tři na tabletu, dva na mobilu.</p><a href="/#co-delam" target="_blank" rel="noreferrer">Vyzkoušet nabídku ↗</a></div></section>
    <section aria-labelledby="author-board"><div class="frame-head"><div><h2 id="author-board">O mně / Dvě fotografie</h2><span class="path">Pod sloganem / původní fotografie Marka</span></div><span class="status draft">Nová pracovní podoba</span></div><a class="screen" href="/#o-mne" target="_blank" rel="noreferrer" aria-label="Otevřít představení webu"><img src={authorPreview.src} width={authorPreview.width} height={authorPreview.height} alt="Dvě černobílé fotografie Marka, momentka a portrét, stejné velikosti se samostatnými kreslenými tahy." /></a><div class="frame-foot"><p>Dvě autorem dodané fotografie se sladěným světlem, zobrazené černobíle. Vlastní SVG tahy mimo tváře. AI retuše a originály jsou zdokumentované.</p><a href="/#o-mne" target="_blank" rel="noreferrer">Otevřít představení webu ↗</a></div></section>

    <section aria-labelledby="home-board"><div class="frame-head"><div><h2 id="home-board">Úvod / Neutrální rozcestník</h2><span class="path">Homepage / harmonikový rozcestník</span></div><span class="status draft">Struktura zapojená</span></div><a class="screen" href="/" target="_blank" rel="noreferrer" aria-label="Otevřít živý úvodní rozcestník"><img src={homePreview.src} width={homePreview.width} height={homePreview.height} alt="Čtyři bílé dlaždice: popel, pastelkové odřezky, absurdní směs a kávová zrnka." /></a><div class="frame-foot"><p>Čtyři bílé dlaždice se sjednocenou sérií ateliérových fotografií kupiček. Podobné umístění, měřítko a osvětlení; samostatná scéna s popelem zůstává zachovaná.</p><a href="/" target="_blank" rel="noreferrer">Vyzkoušet harmoniku ↗</a></div></section>
    <section aria-labelledby="dark-board"><div class="frame-head"><div><h2 id="dark-board">Umím děsit / Popel</h2><span class="path">Druhý krok / samostatný svět</span></div><span class="status">Směr přijatý</span></div><a class="screen" href="/temnota" target="_blank" rel="noreferrer" aria-label="Otevřít interaktivní scénu s popelem"><img src={darkPreview.src} width={darkPreview.width} height={darkPreview.height} alt="Osobní úvod a pět projektových dlaždic Moonika, Mistrovství smíchu, Armelie, Pohovor a Sraz zítra s interaktivním popelem v pozadí." /></a><div class="frame-foot"><p>Osobní úvod, interaktivní popel a pět projektových dlaždic uvnitř temného hero. Moonika vede k vlastní prezentaci knihy; Mistrovství smíchu je v přípravě. Hlavní rozcestník zůstává čtyřdílný.</p><a href="/temnota" target="_blank" rel="noreferrer">Vyzkoušet interaktivní popel ↗</a></div></section>
    <section aria-labelledby="footer-board"><div class="frame-head"><div><h2 id="footer-board">Kontakt / Zakončení</h2><span class="path">Kontaktní otázky a výzva</span></div><span class="status draft">Pracovní návrh</span></div><a class="screen" href="#kontaktni-udaje" target="_blank" rel="noreferrer"><img src={footerPreview.src} width={footerPreview.width} height={footerPreview.height} alt="Společná černá kontaktní patička s e-mailem a telefonem." /></a><div class="frame-foot"><p>Společný kontakt všech veřejných stránek. Na homepage bez odkazu Moje světy. Výběr témat zůstává výše a mění předmět e-mailu; pod ním je opakovaná harmonika a společná patička.</p><a href="#kontaktni-udaje" target="_blank" rel="noreferrer">Vyzkoušet patičku ↗</a></div></section>
    <section aria-labelledby="ai-board"><div class="frame-head"><div><h2 id="ai-board">Nový motiv / Tužka a ryba</h2><span class="path">ImageGen / podle Markových referencí</span></div><span class="status draft">Odložená AI studie</span></div><div class="screen"><img src={aiStudy.src} width={aiStudy.width} height={aiStudy.height} alt="AI studie surrealistického kreativce s fialovými vlasy, tužkou a zlatou rybou." /></div><div class="frame-foot"><p>Nová kompozice vytvořená AI podle dodaných referencí. Aktuální hero používá fotografickou sérii kupiček; tato starší studie není vydávána za Markovo dílo.</p></div></section>
  </div><p class="map"><strong>Další na řadě:</strong> skutečná praxe · kontaktní e-mail</p><p class="hint">Plátna ukazují zachycený stav. Pro pohyb a chování na mobilu otevřete živý náhled. Tento pracovní přehled je dostupný jen při lokálním vývoji a do veřejného buildu se negeneruje.</p></main>
  <script>
    const range = document.querySelector<HTMLInputElement>('input[type="range"]')!;
    const output = document.querySelector('output')!;
    const frames = document.querySelector<HTMLElement>('.frames')!;
    function update() { frames.style.setProperty('--zoom', String(Number(range.value) / 100)); output.value = `${range.value} %`; }
    range.addEventListener('input', update);
    // Start with both boards fitting the available area; controls stay editable.
    range.value = String(Math.max(40, Math.min(100, Math.floor((innerWidth - 80) / 1120 * 20) * 5)));
    update();
  </script>
</body>
</html>
