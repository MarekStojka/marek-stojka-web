---
import { publicContact } from '../data/contact';
import BrushIcon from './BrushIcon.astro';
interface Props { home?: boolean; }
const {home=false}=Astro.props;
---
<footer class="shared-footer" id="kontaktni-udaje" aria-labelledby="shared-contact-title">
 {!home&&<span id="kontakt" class="footer-anchor" aria-hidden="true"></span>}
 <span id="spojme-se" class="footer-anchor" aria-hidden="true"></span>
 <div class="shared-footer-intro"><h2 id="shared-contact-title">Co vám<br/><em>vrtá hlavou?</em></h2><div class="shared-contact-links"><a class="icon-motion-trigger" data-shared-contact-email data-email={publicContact.email} href={`mailto:${publicContact.email}`}><span>{publicContact.email}</span><BrushIcon kind="words"/></a><a href={`tel:${publicContact.phone.replace(/[^+\d]/g,'')}`}><span>{publicContact.phone}</span><span aria-hidden="true">↗</span></a></div></div>
 <div class="shared-footer-bottom"><a href="/" class="shared-footer-name">Marek Stojka</a><div>{!home&&<a href="/#svety">Moje světy <span aria-hidden="true">↗</span></a>}<a href="#obsah">Nahoru <span aria-hidden="true">↑</span></a></div></div>
</footer>
<style>
 .shared-footer{position:relative;isolation:isolate;margin:6px 20px 20px;padding:75px 6% 28px;background:#171717;color:#f7f6f2;font-family:'Manrope Variable',sans-serif;scroll-margin-top:20px}
 .footer-anchor{position:absolute;top:0;left:0;pointer-events:none}
 .shared-footer-intro{display:grid;grid-template-columns:1fr 1fr;gap:9%;align-items:center;padding-bottom:70px}
 .shared-footer h2{margin:0;font-size:clamp(43px,5.4vw,86px);font-weight:430;line-height:1.05;letter-spacing:-.065em;color:inherit}
 .shared-footer h2 em{font-family:Georgia,serif;font-weight:400;color:inherit}
 .shared-contact-links{display:flex;flex-direction:column;gap:12px;min-width:0}
 .shared-contact-links>a{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:18px 0;border-bottom:1px solid #ffffff35;color:inherit;text-decoration:none;font-size:clamp(22px,2.6vw,40px);letter-spacing:-.045em;overflow-wrap:anywhere}
 .shared-contact-links>a>span:first-child{min-width:0}.shared-contact-links :global(.brush-icon){width:45px;height:45px;flex-shrink:0;color:inherit}
 .shared-footer a:hover{text-decoration:underline;text-underline-offset:7px}.shared-footer a:focus-visible{outline:2px solid #fff;outline-offset:6px}
 .shared-footer-bottom{border-top:1px solid #ffffff25;padding-top:25px;display:flex;justify-content:space-between;gap:25px;align-items:center;font-size:16px}
 .shared-footer-bottom a{color:inherit;text-decoration:none;display:inline-flex;gap:25px;align-items:center;min-height:44px}.shared-footer-bottom>div{display:flex;gap:45px}.shared-footer-name{font-size:20px;letter-spacing:-.035em}
 @media(max-width:800px){.shared-footer-intro{grid-template-columns:1fr;gap:35px;padding-bottom:40px}.shared-contact-links{max-width:650px}}
 @media(max-width:700px){.shared-footer{margin:5px 12px 12px;padding:45px 7% 20px}.shared-footer h2{font-size:48px}.shared-contact-links>a{font-size:clamp(22px,6vw,31px)}.shared-footer-bottom{flex-wrap:wrap;font-size:15px}.shared-footer-bottom>div{gap:28px}.shared-footer-bottom a{gap:13px}}
</style>
