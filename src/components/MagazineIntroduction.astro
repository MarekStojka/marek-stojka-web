---
import { Image } from 'astro:assets';
import banana from '../assets/creative-still-life/banan-zatky-v1.png';
import WorkshopOffer from './WorkshopOffer.astro';

// Pracovní redakční texty pro úvod magazínu, nikoli odborné definice.
const answers = [
  { title: 'Vidět jinak.', text: 'Podívat se na známou věc z nečekané strany.' },
  { title: 'Spojovat nespojitelné.', text: 'Dát dohromady dvě věci, které se ještě nepotkaly.' },
  { title: 'Ptát se „co kdyby?“', text: 'Na chvíli odložit to, jak se něco dělá obvykle.' },
  { title: 'Zkoušet i divný věci.', text: 'Dát šanci nápadu dřív, než ho sami zavrhneme.' },
  { title: 'Hledat další cestu.', text: 'Nespokojit se s první odpovědí, která nás napadne.' },
  { title: 'Dát nápadu podobu.', text: 'Napsat ho. Nakreslit. Postavit. A zjistit, co umí.' },
];
---
<section class="creativity-photo" id="o-magazinu" aria-labelledby="banana-title">
  <h2 id="banana-title">I divný věci můžou být<br /><em>dobrým nápadem.</em></h2>
  <figure>
    <Image src={banana} widths={[640, 1000, 1536]} sizes="(max-width: 700px) calc(100vw - 24px), calc(100vw - 40px)" width={1536} format="webp" quality={90} alt="Banán, na kterém jako pasažéři balancují tři pivní zátky." loading="lazy" />
  </figure>
</section>
<section class="creativity-answers" aria-labelledby="creativity-title">
  <h2 id="creativity-title">Co je vlastně<br /><em>ta kreativita?</em></h2>
  <div class="creativity-answer-grid">
    {answers.map(answer => <article class="creativity-answer"><h3>{answer.title}</h3><p>{answer.text}</p></article>)}
  </div>
</section>
<WorkshopOffer />
<style>
  .creativity-photo { padding: clamp(40px, 5vw, 85px) 0 0; overflow: hidden; }
  .creativity-photo h2 { position: relative; z-index: 1; padding: 0 6%; text-align: center; font-size: clamp(42px, 5.2vw, 90px); text-wrap: balance; }
  .creativity-photo h2 em { color: inherit; }
  .creativity-photo figure { margin: 20px 0 0; }
  .creativity-photo img { display: block; width: 100%; height: max(360px, 38vw); object-fit: cover; object-position: center 55%; }
  .creativity-answers { padding: clamp(48px, 6vw, 100px) 6%; }
  .creativity-answers h2 { margin: 0 0 clamp(35px, 4vw, 65px); text-align: center; font-size: clamp(44px, 5vw, 80px); }
  .creativity-answer-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--editorial-gap); }
  .creativity-answer { padding: clamp(26px, 3vw, 48px); background: #f4f3f1; }
  .creativity-answer h3 { font-size: clamp(26px, 2.35vw, 38px); text-wrap: balance; }
  .creativity-answer p { max-width: 28ch; margin: 20px 0 0; font-size: 18px; line-height: 1.55; }
  @media (max-width: 1000px) {
    .creativity-answer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .creativity-photo { padding-top: 38px; }
    .creativity-photo h2 { padding: 0 7%; font-size: clamp(32px, 8.8vw, 48px); }
    .creativity-photo img { height: clamp(250px, 65vw, 420px); }
    .creativity-photo figure { margin-top: 15px; }
    .creativity-answers { padding: 45px 7%; }
    .creativity-answers h2 { font-size: 43px; margin-bottom: 32px; }
    .creativity-answer-grid { grid-template-columns: 1fr; }
    .creativity-answer { padding: 28px; }
    .creativity-answer h3 { font-size: 29px; }
    .creativity-answer p { margin-top: 13px; }
  }
</style>
