---
import { Image } from 'astro:assets';
import paperFlower from '../assets/creative-still-life/papirova-kvetina-v1.png';
import CreativityHelp from './CreativityHelp.astro';
import CreativityIntroduction from './CreativityIntroduction.astro';

import { creativityExamples } from '../data/creativity-examples';
---
<section class="creativity-photo" id="o-magazinu" aria-labelledby="creativity-still-life-title">
  <h2 id="creativity-still-life-title">I divný věci můžou být<br /><em>dobrým nápadem.</em></h2>
  <figure>
    <Image src={paperFlower} widths={[320, 600, 1000]} sizes="(max-width: 420px) 80vw, (max-width: 700px) 320px, 500px" width={1000} format="webp" quality={90} alt="Papírová květina ze zmačkaného papíru a fialové tužky v malé skleněné váze." loading="lazy" />
  </figure>
</section>
<CreativityIntroduction />
<section class="creativity-answers" id="muj-pohled-na-kreativitu" aria-labelledby="creativity-personal-title">
  <header>
    <h2 id="creativity-personal-title">Jak k takovému<br /><em>nápadu dojít?</em></h2>
    <p class="creativity-personal-lead">Zkouším různé cesty. Tohle mi při tom pomáhá — a zjednodušené příběhy skutečných vynálezů ukazují, jak to může vypadat v praxi.</p>
  </header>
  <div class="creativity-answer-grid">
    {creativityExamples.map(answer => (
      <article class="creativity-answer">
        <h3>{answer.title}</h3>
        <p>{answer.text}</p>
        <div class="creativity-example">
          <h4>{answer.exampleTitle}</h4>
          <p>{answer.example}</p>
        </div>
      </article>
    ))}
  </div>
</section>
<CreativityHelp />
<style>
  .creativity-photo { padding: clamp(40px, 5vw, 85px) 0 40px; overflow: hidden; }
  .creativity-photo h2 { position: relative; z-index: 1; padding: 0 6%; text-align: center; font-size: clamp(42px, 5.2vw, 90px); text-wrap: balance; }
  .creativity-photo h2 em { color: inherit; }
  .creativity-photo figure { margin: 28px auto 0; width: min(70%, 500px); }
  .creativity-photo img { display: block; width: 100%; height: auto; aspect-ratio: 4/5; object-fit: contain; }
  .creativity-answers { padding: clamp(48px, 6vw, 100px) 6%; }
  .creativity-answers header { margin: 0 auto clamp(35px, 4vw, 65px); text-align: center; }
  .creativity-answers h2 { font-size: clamp(44px, 5vw, 80px); }
  .creativity-answers .creativity-personal-lead { max-width: 55ch; margin: 25px auto 0; font-size: 20px; }
  .creativity-answer-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--editorial-gap); }
  .creativity-answer { display: grid; grid-template-rows: subgrid; grid-row: span 3; row-gap: 0; padding: clamp(26px, 3vw, 48px); background: #f4f3f1; }
  .creativity-answer h3 { font-size: clamp(26px, 2.35vw, 38px); text-wrap: balance; }
  .creativity-answer p { max-width: 28ch; margin: 20px 0 0; font-size: 18px; line-height: 1.55; }
  .creativity-answer > p { margin-bottom: 28px; }
  .creativity-example { padding-top: 23px; border-top: 1px solid #d7d5d2; }
  .creativity-example h4 { margin: 0; font-size: 20px; font-weight: 600; line-height: 1.35; letter-spacing: -.025em; }
  .creativity-example p { margin-top: 12px; max-width: 36ch; color: #444; font-size: 17px; line-height: 1.65; }
  @media (max-width: 1000px) {
    .creativity-answer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .creativity-photo { padding-top: 38px; }
    .creativity-photo h2 { padding: 0 7%; font-size: clamp(32px, 8.8vw, 48px); }
    .creativity-photo figure { margin-top: 22px; width: min(84%, 320px); }
    .creativity-answers { padding: 45px 7%; }
    .creativity-answers h2 { font-size: 43px; }
    .creativity-answers .creativity-personal-lead { font-size: 18px; margin-top: 23px; }
    .creativity-answer-grid { grid-template-columns: 1fr; }
    .creativity-answer { padding: 28px; }
    .creativity-answer h3 { font-size: 29px; }
    .creativity-answer p { margin-top: 13px; }
  }
</style>
