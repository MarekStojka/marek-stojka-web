---
import { Image } from 'astro:assets';
import { withBase } from '../lib/site-path';
import { creativeCategories } from '../data/creative-categories';
import { creativePhotos } from '../data/creative-photos';
interface Props { currentCategory: typeof creativeCategories[number]['id']; }
const { currentCategory } = Astro.props;
---
<nav class="magazine-more-rubrics" id="dalsi-rubriky" aria-labelledby="more-rubrics-title">
  <h2 id="more-rubrics-title">Kam dál?</h2>
  <div class="more-rubrics-grid">
    {creativeCategories.filter(category => category.id !== currentCategory).map(category =>
      <a class="more-rubrics-tile" href={withBase(`/kreativec/magazin/${category.id}`)}>
        <Image src={creativePhotos[category.id]} width={240} widths={[120,240]} sizes="120px" format="webp" alt="" loading="lazy" />
        <span class="more-rubrics-label">{category.title}<span aria-hidden="true">↗</span></span>
      </a>
    )}
  </div>
</nav>
<style>
  :global(.editorial-page main) > .magazine-more-rubrics { padding: 45px 5% 55px; background: #f6f6f4; }
  .magazine-more-rubrics h2 { font-size: 34px; margin: 0 0 28px; }
  .more-rubrics-grid { display: grid; grid-template-columns: repeat(7,minmax(0,1fr)); gap: var(--editorial-gap,6px); }
  .more-rubrics-tile { display: flex; flex-direction: column; align-items: center; gap: 20px; min-width: 0; padding: 22px 15px; background: #fff; color: #222; }
  .more-rubrics-tile img { width: min(100%,110px); height: 110px; object-fit: contain; transition: transform .25s ease; }
  .more-rubrics-label { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; width: 100%; font-size: 18px; line-height: 1.35; letter-spacing: -.035em; }
  .more-rubrics-label > span { flex: none; color: #7433c7; }
  .more-rubrics-tile:hover { color: #7433c7; }
  .more-rubrics-tile:hover img,.more-rubrics-tile:focus-visible img { transform: translateY(-4px) rotate(-3deg); }
  .more-rubrics-tile:focus-visible { outline-offset: -3px; }
  @media(max-width:1100px) { .more-rubrics-grid { grid-template-columns: repeat(4,minmax(0,1fr)); } }
  @media(max-width:700px) {
    :global(.editorial-page main) > .magazine-more-rubrics { padding: 35px 6% 42px; }
    .magazine-more-rubrics h2 { font-size: 31px; }
    .more-rubrics-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .more-rubrics-tile { padding: 18px 12px; gap: 16px; }
    .more-rubrics-tile img { width: min(100%,90px); height: 90px; }
    .more-rubrics-label { font-size: 17px; }
  }
  @media(prefers-reduced-motion:reduce) {
    .more-rubrics-tile img { transition: none; }
    .more-rubrics-tile:hover img,.more-rubrics-tile:focus-visible img { transform: none; }
  }
</style>
