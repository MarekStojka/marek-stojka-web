---
import { publicContact } from '../data/contact';
const options = [
  {
    id: 'creativity-help-title',
    title: 'S kreativitou',
    emphasis: 'vám pomůžu.',
    text: 'Máte nápad a nevíte, jak s ním dál? Nebo se potřebujete podívat na své zadání jinak? Můžeme společně hledat nové možnosti a vybrat ty, které dávají smysl.',
    action: 'Napište mi, co řešíte',
    subject: 'Pomoc s kreativním nápadem',
  },
  {
    id: 'creativity-project-title',
    title: 'Vytvořme něco',
    emphasis: 'společně.',
    text: 'Máte projekt, ke kterému hledáte tvůrčího parťáka? Můžeme společně vymyslet koncept a dát mu podobu v textech, grafice nebo na webu. Napište mi, co chcete vytvořit.',
    action: 'Probrat spolupráci',
    subject: 'Spolupráce na projektu',
  },
  {
    id: 'creativity-courses-title',
    title: 'Rozvíjejte svou',
    emphasis: 'kreativitu.',
    text: 'Chcete se naučit dívat na věci jinak a snáz rozvíjet vlastní nápady? Připravuji kurzy a workshopy kreativity. Napište mi, co byste si chtěli vyzkoušet nebo v čem se posunout.',
    action: 'Zajímá mě kurz',
    subject: 'Zájem o kurz kreativity',
  },
];
---
<section class="creativity-help" id="pomoc-s-kreativitou" aria-label="Pomoc s kreativitou, spolupráce a kurzy">
  {options.map(option => (
    <article aria-labelledby={option.id}>
      <h2 id={option.id}>{option.title}<br /><em>{option.emphasis}</em></h2>
      <p>{option.text}</p>
      <a href={`mailto:${publicContact.email}?subject=${encodeURIComponent(option.subject)}`}>
        {option.action} <span aria-hidden="true">↗</span>
      </a>
    </article>
  ))}
</section>
<style>
  :global(.editorial-page main) > .creativity-help { background: transparent; }
  .creativity-help { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--editorial-gap, 6px); }
  .creativity-help article { display: grid; grid-template-rows: subgrid; grid-row: span 3; justify-items: center; row-gap: 28px; padding: clamp(36px, 3.5vw, 60px) clamp(24px, 3vw, 52px); background: #7433c7; color: #fff; text-align: center; }
  .creativity-help h2 { font-size: clamp(32px, 2.8vw, 48px); text-wrap: balance; }
  .creativity-help h2 em { color: inherit; }
  .creativity-help p { max-width: 42ch; margin: 0; color: #fff; font-size: 18px; line-height: 1.65; }
  .creativity-help a { display: inline-flex; gap: 20px; align-items: center; justify-content: center; align-self: end; min-height: 56px; padding: 17px 22px; background: #fff; color: #222; font-size: 17px; line-height: 1.4; }
  .creativity-help a:hover { background: #f2eafa; }
  .creativity-help a:focus-visible { outline: 2px solid #fff; outline-offset: 6px; }
  @media (max-width: 1000px) {
    .creativity-help { grid-template-columns: 1fr; }
    .creativity-help article { grid-template-rows: auto; grid-row: auto; padding: 46px 7%; }
    .creativity-help h2 { font-size: 39px; }
  }
  @media (max-width: 700px) {
    .creativity-help article { row-gap: 24px; padding: 40px 7%; }
    .creativity-help h2 { font-size: clamp(32px, 9vw, 39px); }
  }
</style>
