<script>
  import { navigate } from 'astro:transitions/client';

  let cleanup = () => {};
  let initializedRoot: Element | null = null;

  function setupGuideNavigation() {
    const root = document.querySelector('.creativity-overview-page');
    if (root === initializedRoot) return;
    cleanup();
    initializedRoot = root;
    if (!root) return;
    const controller = new AbortController();
    const { signal } = controller;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;
    let run = 0;
    let activeTarget: HTMLElement | null = null;

    function cancel() {
      run++;
      cancelAnimationFrame(frame);
      frame = 0;
      activeTarget = null;
    }

    async function follow(link: HTMLAnchorElement, target: HTMLElement) {
      cancel();
      const currentRun = run;
      const body = document.body;
      const from = scrollY;
      const left = scrollX;
      // Focus also reveals the destination through SiteMotion, before measuring it.
      target.focus({ preventScroll: true });
      activeTarget = target;
      // Keep Astro's history entries and page restoration. The same-page update
      // completes before paint; then one controlled scroll replaces its native jump.
      await navigate(link.href, { sourceElement: link });
      if (run !== currentRun || document.body !== body) return;
      const offset = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
      const destination = Math.max(0, Math.min(
        target.getBoundingClientRect().top + scrollY - offset - margin,
        document.documentElement.scrollHeight - innerHeight,
      ));
      if (reducedMotion.matches || Math.abs(destination - from) < 2) {
        window.scrollTo({ left, top: destination, behavior: 'instant' });
        cancel();
        return;
      }
      window.scrollTo({ left, top: from, behavior: 'instant' });
      const started = performance.now();
      function step(now: number) {
        const progress = Math.min((now - started) / 500, 1);
        const eased = progress < .5 ? 4 * progress ** 3 : 1 - (-2 * progress + 2) ** 3 / 2;
        window.scrollTo({ left, top: from + (destination - from) * eased, behavior: 'instant' });
        if (progress < 1) frame = requestAnimationFrame(step);
        else cancel();
      }
      frame = requestAnimationFrame(step);
    }

    root.addEventListener('click', event => {
      if (!(event instanceof MouseEvent) || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[data-guide-anchor]') : null;
      if (!link || link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
      const url = new URL(link.href);
      if (url.origin !== location.origin || url.pathname !== location.pathname || url.search !== location.search) return;
      let id: string;
      try { id = decodeURIComponent(url.hash.slice(1)); } catch { return; }
      const target = document.getElementById(id);
      if (!target || !root.contains(target)) return;
      event.preventDefault();
      event.stopPropagation();
      void follow(link, target).catch(() => { cancel(); location.assign(link.href); });
    }, { capture: true, signal });
    // PageInteractions must not start a second scroll while this one is running.
    window.addEventListener('hashchange', event => {
      if (activeTarget) event.stopImmediatePropagation();
    }, { capture: true, signal });
    for (const type of ['wheel', 'touchstart', 'pointerdown', 'resize']) {
      window.addEventListener(type, cancel, { passive: true, signal });
    }
    window.addEventListener('popstate', () => {
      // Astro may emit popstate while committing this very fragment.
      if (activeTarget && location.hash === `#${activeTarget.id}`) return;
      cancel();
    }, { signal });
    window.addEventListener('keydown', event => {
      if (['Escape', 'ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' '].includes(event.key)) cancel();
    }, { signal });
    document.addEventListener('visibilitychange', () => { if (document.hidden) cancel(); }, { signal });
    reducedMotion.addEventListener('change', () => {
      if (!reducedMotion.matches || !activeTarget) return;
      const target = activeTarget;
      cancel();
      target.scrollIntoView({ behavior: 'instant', block: 'start' });
    }, { signal });
    cleanup = () => { cancel(); controller.abort(); };
  }

  document.addEventListener('astro:before-swap', () => { cleanup(); initializedRoot = null; });
  document.addEventListener('astro:page-load', setupGuideNavigation);
  setupGuideNavigation();
</script>
