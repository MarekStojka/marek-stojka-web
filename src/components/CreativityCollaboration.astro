---
// Pracovní popis nabídky, bez vymyšlených zakázek, výsledků nebo termínů.
const steps = [
  {
    title: 'Ujasníme si zadání.',
    text: 'Probereme, co chcete sdělit, komu a čeho potřebujete dosáhnout. Pomůžu vám pojmenovat, co už funguje a kde se hledání zaseklo.',
  },
  {
    title: 'Najdeme různé možnosti.',
    text: 'Zkusíme jiné úhly pohledu a nečekaná spojení. Může jít o téma, text, název, vizuální nápad nebo způsob, jak jednodušeji vysvětlit složitou věc.',
  },
  {
    title: 'Dáme nápadu podobu.',
    text: 'Vybereme směr, který dává smysl pro vaše zadání. Podle potřeby ho rozpracuji do textu, grafiky nebo návrhu webu, se kterým se dá pokračovat.',
  },
];
---
<section class="creativity-collaboration" id="jak-pomuzu" aria-labelledby="creativity-collaboration-title">
  <header>
    <h2 id="creativity-collaboration-title">Od zadání<br /><em>ke konkrétnímu nápadu.</em></h2>
    <p>Můžeme začít u jedné otázky i rozpracovaného projektu.</p>
  </header>
  <div class="creativity-collaboration-steps">
    {steps.map(step => (
      <article>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </article>
    ))}
  </div>
</section>
<style>
  .creativity-collaboration { padding: clamp(50px, 6vw, 90px) 6%; }
  header { max-width: 850px; margin: 0 auto 50px; text-align: center; }
  h2 { font-size: clamp(38px, 4.2vw, 64px); text-wrap: balance; }
  header p { margin: 24px 0 0; font-size: 20px; }
  .creativity-collaboration-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(25px, 4vw, 65px); }
  article { border-top: 1px solid #d7d5d2; padding-top: 28px; }
  h3 { font-size: clamp(25px, 2.1vw, 33px); text-wrap: balance; }
  article p { max-width: 36ch; margin: 20px 0 0; font-size: 18px; line-height: 1.7; }
  @media (max-width: 1000px) {
    .creativity-collaboration-steps { grid-template-columns: 1fr; gap: 30px; }
    article p { max-width: 65ch; }
  }
  @media (max-width: 700px) {
    .creativity-collaboration { padding: 40px 7%; }
    header { margin-bottom: 35px; }
    h2 { font-size: clamp(34px, 8.7vw, 42px); }
    header p { margin-top: 22px; font-size: 18px; }
    article { padding-top: 24px; }
    h3 { font-size: 28px; }
    article p { margin-top: 16px; font-size: 18px; }
  }
</style>
