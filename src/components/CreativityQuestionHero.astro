---
import { Image } from 'astro:assets';
import { creativePhotos } from '../data/creative-photos';
import { withBase } from '../lib/site-path';
const questions = [
  { text: 'Co vlastně znamená být kreativní?', target: 'co-je-kreativita' },
  { text: 'Byli jsme kreativní odjakživa?', target: 'historie' },
  { text: 'Může mít dobré nápady každý?', target: 'kdo-tvori' },
  { text: 'Odkud se berou nápady?', target: 'inspirace' },
  { text: 'Proč mi to někdy nejde?', target: 'prekazky' },
  { text: 'Dá se kreativita trénovat?', target: 'rozvijeni' },
];
---
<header class="overview-hero" data-question-hero>
  <a class="overview-back" href={withBase('/kreativec#zapisnik')}><span aria-hidden="true">←</span> Zpět do magazínu</a>
  <h1 tabindex="-1">Obecně <em>o kreativitě.</em></h1>
  <div class="guide-orbit">
    <button class="guide-paper" type="button" aria-label="Znovu rozhýbat otázky kolem kuličky" title="Rozhýbat otázky" disabled>
      <Image src={creativePhotos.obecne} alt="Zmačkaná papírová kulička." width={600} widths={[280,440,600]} sizes="(max-width: 700px) 230px, 360px" loading="eager" />
    </button>
    <nav class="guide-questions" aria-label="Otázky o kreativitě">
      {questions.map((question,index) => <a class={`guide-question guide-question-${index+1}`} data-guide-anchor href={`#${question.target}`}>{question.text}<span aria-hidden="true">↗</span></a>)}
    </nav>
  </div>
  <div class="guide-hero-bottom"><p>Vyberte si otázku, která vám právě vrtá hlavou.</p><a class="overview-text-link" data-guide-anchor href="#co-je-kreativita">Prohlédnout od začátku <span aria-hidden="true">↓</span></a></div>
</header>
<script>
function setupQuestionHero() {
  const root = document.querySelector<HTMLElement>('[data-question-hero]');
  if (!root || root.dataset.initialized) return;
  root.dataset.initialized = 'true';
  const controller = new AbortController();
  const { signal } = controller;
  const media = matchMedia('(prefers-reduced-motion: reduce)');
  const button = root.querySelector<HTMLButtonElement>('.guide-paper')!;
  const image = button.querySelector('img')!;
  const questions = [...root.querySelectorAll<HTMLElement>('.guide-question')];
  let animations: Animation[] = [];
  let entered = false;
  const stop = () => { animations.forEach(animation => animation.cancel()); animations = []; };
  function reveal(animatePaper = true) {
    stop();
    if (media.matches) return;
    animations = questions.map((question,index) => question.animate([
      { opacity: 0, transform: `translateY(24px) scale(.82)` },
      { opacity: 1, transform: 'translateY(-5px) scale(1.035)', offset: .7 },
      { opacity: 1, transform: 'translateY(0) scale(1)' },
    ], { duration: 620, delay: index * 110, fill: 'backwards', easing: 'cubic-bezier(.2,.7,.25,1)' }));
    if (animatePaper) animations.push(image.animate([
      { transform: 'rotate(-8deg) scale(.88)' },
      { transform: 'rotate(4deg) scale(1.04)', offset: .65 },
      { transform: 'rotate(0) scale(1)' },
    ], { duration: 740, easing: 'cubic-bezier(.2,.7,.25,1)' }));
  }
  button.disabled = false;
  button.addEventListener('click', () => reveal(), { signal });
  root.addEventListener('focusin', event => { if (event.target !== button) stop(); }, { signal });
  const observer = new IntersectionObserver(entries => {
    if (entries[0].isIntersecting && !entered && !document.documentElement.hasAttribute('data-paper-ball-landing')) { entered = true; reveal(); }
    if (!entries[0].isIntersecting) stop();
  }, { threshold: .15 });
  observer.observe(root);
  document.addEventListener('paper-ball-arrive', () => { if (!entered) { entered = true; reveal(false); } }, { signal });
  media.addEventListener('change', stop, { signal });
  document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); }, { signal });
  document.addEventListener('astro:before-swap', () => { stop(); observer.disconnect(); controller.abort(); delete root.dataset.initialized; }, { once: true, signal });
}
document.addEventListener('astro:page-load', setupQuestionHero);
setupQuestionHero();
</script>
