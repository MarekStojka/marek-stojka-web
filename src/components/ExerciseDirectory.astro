---
import { creativeExercises } from '../data/creative-exercises';
import { exerciseCollections } from '../data/exercise-collections';
import BrushIcon from './BrushIcon.astro';
import ExerciseCard from './ExerciseCard.astro';
import '../styles/icon-motion.css';
import '../styles/creative-exercises.css';
---
<section class="exercise-library" aria-label="Knihovna kreativních cvičení" data-motion-skip>
  <div class="exercise-chooser" id="exercise-list">
    <div class="exercise-chooser-heading">
      <h2>Co se vám právě hodí?</h2>
      <p>Vyberte si podle lidí, času nebo toho, co chcete tvořit. Dlaždice vás posune rovnou k příslušným cvičením.</p>
    </div>
    <nav class="exercise-collection-nav" aria-label="Vybrat cvičení podle využití">
      {exerciseCollections.map(collection => <a href={`#${collection.id}`} class="exercise-collection-link icon-motion-trigger">
        <BrushIcon kind={collection.icon} />
        <strong>{collection.title}</strong>
        <span>{collection.subtitle}</span>
        <span class="exercise-collection-count">{collection.exercises.length} cvičení <span aria-hidden="true">↓</span></span>
      </a>)}
    </nav>
    <p class="exercise-selection-note">{creativeExercises.length} různých cvičení, šest cest k výběru. Některá najdete ve více sekcích.</p>
  </div>
  <div class="exercise-collections">
    {exerciseCollections.map(collection => <section id={collection.id} class="exercise-collection" aria-labelledby={`${collection.id}-title`} tabindex="-1">
      <header class="exercise-collection-heading">
        <div><h2 id={`${collection.id}-title`}>{collection.title}</h2><p>{collection.intro}</p></div>
        <div class="exercise-collection-meta"><span>{collection.exercises.length} cvičení{collection.id === 'rychlovky' && ' · do 15 minut'}</span><a href="#exercise-list">Zpět na výběr <span aria-hidden="true">↑</span></a></div>
      </header>
      <ul class="exercise-grid">
        {collection.exercises.slice(0, 5).map(exercise => <li><ExerciseCard exercise={exercise} /></li>)}
      </ul>
      {collection.exercises.length > 5 && <details class="exercise-collection-more">
        <summary>
          <span class="exercise-show-more">Zobrazit všechna cvičení v této sekci <span>({collection.exercises.length})</span></span>
          <span class="exercise-show-less">Sbalit na prvních 5 cvičení</span>
          <span class="exercise-expand-mark" aria-hidden="true">+</span>
        </summary>
        <ul class="exercise-grid">
          {collection.exercises.slice(5).map(exercise => <li><ExerciseCard exercise={exercise} /></li>)}
        </ul>
      </details>}
    </section>)}
  </div>
  <p class="exercise-editorial-note">Česká zadání a modelové příklady jsou redakční adaptace. Časy jsou orientační pro zde popsanou verzi. Cvičení nejsou diagnostické testy ani příslib měřitelného zvýšení kreativity.</p>
</section>
