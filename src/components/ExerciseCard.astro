---
import type { CreativeExercise } from '../data/creative-exercises';
import { withBase } from '../lib/site-path';
import ExerciseIcon from './ExerciseIcon.astro';
interface Props { exercise: CreativeExercise; }
const { exercise } = Astro.props;
---
<a href={withBase(`/kreativec/cviceni/${exercise.slug}`)} class="exercise-card icon-motion-trigger" data-exercise-slug={exercise.slug}>
  <span class="exercise-card-icon"><ExerciseIcon slug={exercise.slug} /></span>
  <h3>{exercise.title}</h3>
  <span class="exercise-card-time">Přibližně {exercise.minutes} min</span>
</a>
