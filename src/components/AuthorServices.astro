---
interface Props {
  services: readonly { title: string; description: string }[];
}
const { services } = Astro.props;
---
<section id="co-delam" class="author-offer" aria-labelledby="offer-title">
  <h2 id="offer-title">S čím pomůžu.</h2>
  <div class="offer-list">
    {services.map((service) => <details class="offer-item" name="author-offer"><summary><span>{service.title}</span><span class="offer-plus" aria-hidden="true">+</span></summary><p>{service.description}</p></details>)}
  </div>
</section>
